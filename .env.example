# Copy this file to .env and set the API URL for the environment you are using.
# Do not put passwords, bearer tokens, or other secrets in this file.

# Local Laravel API on the same machine:
API_BASE_URL=http://127.0.0.1:8000

# Android emulator example:
# API_BASE_URL=http://10.0.2.2:8000

# Physical device example (replace with your development machine's LAN IP):
# API_BASE_URL=http://192.168.1.100:8000
